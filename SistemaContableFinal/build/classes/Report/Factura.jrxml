	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Sistema_Contable.jrdax"/>
	<parameter name="facturaID" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
    f.idFactura AS "NumeroFactura",
    f.fechaFactura AS "FechaFactura",
    f.tipoFactura AS "TipoFactura",
    c.nombreCliente || ' ' || c.apellidoCliente AS "Cliente",
    a.nombreArticulo AS "Producto",
    dv.cantidad AS "Cantidad",
    dv.precioVenta AS "PrecioUnitario",
    dv.subTotal AS "SubTotal",
    f.totalFactura AS "ValorTotal"
FROM Factura f
JOIN Venta v ON f.idVenta = v.idVenta
JOIN Cliente c ON v.idCliente = c.idCliente
JOIN DetalleVenta dv ON v.idVenta = dv.idVenta
JOIN Articulo a ON dv.idArticulo = a.idArticulo
WHERE f.idFactura = $P{facturaID}
]]>
	</queryString>
