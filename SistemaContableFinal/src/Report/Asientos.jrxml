	<parameter name="idUsuario" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT  u.username , a.idAsiento, a.fecha , ac.idAsientoCuenta , ac.idCuenta, ac.tipo, ac.monto, a.descripcionAsiento , c.nombreCuenta , ac.saldoPostOperacion FROM Asiento a INNER JOIN Asiento_Cuenta ac ON a.idAsiento=ac.idAsiento INNER JOIN Cuenta as c ON ac.idCuenta=c.idCuenta  INNER JOIN Usuario as u ON u.idUsuario=a.idUsuario WHERE a.fecha BETWEEN $P{fechaInicio} AND  $P{fechaFin} AND ($P{idUsuario} IS NULL OR u.idUsuario = $P{idUsuario})  ORDER BY a.fecha ASC,ac.idAsientoCuenta ASC]]>
	</queryString>
