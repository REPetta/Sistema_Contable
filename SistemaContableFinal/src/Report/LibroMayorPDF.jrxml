	<parameter name="idC" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT a.idUsuario ,a.idAsiento, a.fecha , ac.idAsientoCuenta , ac.idCuenta, ac.tipo, ac.saldoPostOperacion ,ac.monto, a.descripcionAsiento,c.nombreCuenta FROM Asiento a INNER JOIN Asiento_Cuenta ac ON a.idAsiento=ac.idAsiento INNER JOIN Cuenta c ON ac.idCuenta=c.idCuenta WHERE a.fecha <= $P{fechaFin} AND ac.idCuenta = $P{idC} ORDER BY a.fecha ASC,ac.idAsientoCuenta ASC]]>
	</queryString>
