<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Facturacion" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="8e6afdce-b477-4878-bf84-5c8c91ea4010">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Sistema_Contable.jrdax"/>
	<parameter name="fechaFactura" class="java.util.Date"/>
	<parameter name="codigoArticulo" class="java.lang.Integer"/>
	<parameter name="dni" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT f.idFactura, f.numeroFactura, f.totalFactura, f.tipoFactura, 
       c.nombreCliente AS nombre_cliente, 
       STRING_AGG(a.nombreArticulo, ', ') AS productos
FROM Factura AS f
INNER JOIN Venta AS v ON f.idVenta = v.idVenta
INNER JOIN Cliente AS c ON v.idCliente = c.idCliente
INNER JOIN DetalleVenta AS dv ON v.idVenta = dv.idVenta
INNER JOIN Articulo AS a ON dv.idArticulo = a.idArticulo
WHERE f.idFactura IN (
    -- Subconsulta para obtener las facturas que contienen al menos un producto con el código filtrado
    SELECT DISTINCT f.idFactura
    FROM Factura f
    INNER JOIN Venta v ON f.idVenta = v.idVenta
    INNER JOIN DetalleVenta dv ON v.idVenta = dv.idVenta
    INNER JOIN Articulo a ON dv.idArticulo = a.idArticulo
    WHERE f.fechaFactura = $P{fechaFactura}  
    AND (a.codigoArticulo = $P{codigoArticulo} OR $P{codigoArticulo} IS NULL)  
)
AND f.fechaFactura = $P{fechaFactura}  
AND (c.dni = $P{dni} OR $P{dni} IS NULL) 
GROUP BY f.idFactura, f.numeroFactura, f.totalFactura, f.tipoFactura, c.nombreCliente
ORDER BY f.idFactura]]>
	</queryString>
